{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Papyrbound",
  "version": "0.1.0",
  "identifier": "com.papyrbound.reader",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "Papyrbound",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "fileAssociations": [
      { "ext": ["epub"], "name": "EPUB book", "mimeType": "application/epub+zip", "role": "Viewer" },
      { "ext": ["cbz"], "name": "Comic book archive", "mimeType": "application/vnd.comicbook+zip", "role": "Viewer" }
    ],
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
